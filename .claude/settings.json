{
  "permissions": {
    "allow": [
      "Bash(gh run watch *)",
      "Bash(make --dry-run *)",
      "Bash(make lint-fast)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-gate.sh\"",
            "statusMessage": "Checking self-review gate..."
          }
        ]
      }
    ]
  }
}
